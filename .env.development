# 本地开发：Vite 将 /api/* 代理到该地址（默认 8787，与 draw-sync / Java 一致）
VITE_BACKEND_URL=http://127.0.0.1:8787

# 留空 = 浏览器走相对路径 + 代理（推荐）
# 真机/平板调试时改为电脑局域网地址，例如：
# VITE_API_ORIGIN=http://192.168.1.232:8787
VITE_API_ORIGIN=

# 若仍用 Node 小服务，可单独覆盖（一般不必）：
# VITE_DRAW_SYNC_URL=/api/draw
# VITE_CAD_PREVIEW_URL=/api/v1/cad
