# 复制为 .env.development.local 可覆盖本机配置（.env*.local 不会提交 Git）

# Java / 统一后端根地址（仅影响 Vite dev 代理目标）
VITE_BACKEND_URL=http://127.0.0.1:8787

# 前端直连后端（跳过代理，用于手机访问电脑上的 Java）
# VITE_API_ORIGIN=http://192.168.1.232:8787

# 单独覆盖某一模块 API（可选）
# VITE_DRAW_SYNC_URL=http://127.0.0.1:8787/api/draw
# VITE_CAD_PREVIEW_URL=http://127.0.0.1:8787/api/v1/cad
