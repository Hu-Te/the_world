# 复制为 .env 后按需修改

# Java 后端（开发代理 /api → 此地址）
NUXT_BACKEND_URL=http://127.0.0.1:8787

# 可选：前端直连 API 源（一般留空，走相对路径 /api）
NUXT_PUBLIC_API_ORIGIN=

# 部署 Token：仅服务端/Agent 使用，切勿配置 NUXT_PUBLIC_*（会打进浏览器包）
# NUXT_API_TOKEN=  # 可选，同 APP_API_TOKEN；静态站可不设（工具页走用户 JWT）

# 站点
NUXT_PUBLIC_SITE_NAME=工具站
NUXT_PUBLIC_SITE_TAGLINE=实用小工具集合

# 管理员微信二维码（登录弹窗「联系管理员创建账号」）
# 默认已指向 public/iam/wechat-admin-qr.png；换文件名时再改：
# NUXT_PUBLIC_ADMIN_WECHAT_QR=/iam/wechat-admin-qr.png
# NUXT_PUBLIC_ADMIN_WECHAT_ID=你的微信号（可选展示）
