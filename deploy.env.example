# 复制为 deploy.env 后填写（deploy.env 已在 .gitignore 中忽略）

# 服务器公网 IP
DEPLOY_HOST=124.221.150.24

# SSH 用户名（腾讯云 Ubuntu 镜像默认 ubuntu）
DEPLOY_USER=ubuntu

# SSH 端口
DEPLOY_PORT=22

# Nginx 站点根目录（须与 /etc/nginx 中 root 一致）
DEPLOY_PATH=/home/ubuntu/_deploy/three-city

# SFTP 上传目录（可与 DEPLOY_PATH 相同）
DEPLOY_STAGE=/home/ubuntu/_deploy/three-city

# SSH 密码（勿提交到 Git）
DEPLOY_PASS=你的密码

# 上传超时（毫秒）
DEPLOY_TIMEOUT=10000000

# 仅 Java / 现场 Agent 使用；禁止再通过 NUXT_PUBLIC_* 打进浏览器包
APP_API_TOKEN=

# --- 常用命令 ---
# gulp test-auth     测试 SFTP 账号
# npm run deploy     打包 + 上传 + 同步 Nginx
# make -C ../myweb_JAVA deploy   Java JAR

# Java 后端部署见 ../myweb_JAVA/ops/scripts/deploy-jar.cjs
# SSL / Nginx 站点见 ../myweb_JAVA/ops/scripts/deploy-ssl.cjs
