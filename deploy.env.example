# 复制为 deploy.env 后填写（deploy.env 已在 .gitignore 中忽略）

# 服务器公网 IP
DEPLOY_HOST=124.221.150.24

# SSH 用户名（腾讯云 Ubuntu 镜像默认 ubuntu）
DEPLOY_USER=ubuntu

# SSH 端口
DEPLOY_PORT=22

# Nginx 站点根目录（生产静态文件最终目录）
DEPLOY_PATH=/home/ubuntu/www/three-city

# SFTP 暂存目录（ubuntu 上传后 sudo 同步到 DEPLOY_PATH）
DEPLOY_STAGE=/home/ubuntu/_deploy/three-city

# SSH 密码（勿提交到 Git）
DEPLOY_PASS=你的密码

# 上传超时（毫秒）
DEPLOY_TIMEOUT=10000000

# --- 常用命令 ---
# gulp test-auth     测试 SFTP 账号
# npm run deploy     打包 + 上传 + 同步 Nginx
# ./scripts/deploy.sh  rsync 方式部署（需本机 rsync/ssh）

# Java 后端部署见 ../myweb_JAVA/scripts/deploy-jar.cjs
# SSL / Nginx 站点见 ../myweb_JAVA/scripts/deploy-ssl.cjs
