# 复制为 deploy.env 后填写（deploy.env 已在 .gitignore 中忽略）

# 服务器公网 IP
DEPLOY_HOST=124.221.150.24

# SSH 用户名（腾讯云 Ubuntu 镜像默认 ubuntu）
DEPLOY_USER=ubuntu

# SSH 端口
DEPLOY_PORT=22

# Nginx 站点根目录
DEPLOY_PATH=/home/ubuntu/www/three-city

# SFTP 暂存目录（ubuntu 账号上传到这里，再 sudo 同步到 DEPLOY_PATH）
DEPLOY_STAGE=/home/ubuntu/_deploy/three-city

# SFTP 密码（勿提交到 Git）
DEPLOY_PASS=你的密码

# 上传超时（毫秒）
DEPLOY_TIMEOUT=10000000

# draw-sync 服务目录（Ubuntu 用户可写）
DRAW_SYNC_PATH=/home/ubuntu/three-city-sync

# --- Gulp 命令 ---
# gulp test-auth     测试 SFTP 账号
# gulp deploy        打包 + 上传 + 同步到 Nginx 目录 + 部署 draw-sync
# npm run dev:all    本地开发（Vite + draw-sync）
