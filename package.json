{
  "name": "three-city",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/run-with-nvm.sh nuxt dev",
    "dev:host": "bash scripts/run-with-nvm.sh nuxt dev --host",
    "build": "bash scripts/run-with-nvm.sh nuxt generate",
    "preview": "bash scripts/run-with-nvm.sh nuxt preview",
    "postinstall": "bash scripts/run-with-nvm.sh nuxt prepare || nuxt prepare",
    "lint": "bash scripts/run-with-nvm.sh eslint .",
    "lint:fix": "bash scripts/run-with-nvm.sh eslint . --fix",
    "format": "bash scripts/run-with-nvm.sh prettier --write .",
    "format:check": "bash scripts/run-with-nvm.sh prettier --check .",
    "typecheck": "bash scripts/run-with-nvm.sh nuxt typecheck",
    "check": "yarn lint && yarn typecheck && yarn format:check",
    "deploy": "bash scripts/run-with-nvm.sh gulp --gulpfile scripts/gulpfile.cjs deploy"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@pinia/nuxt": "^0.11.2",
    "element-plus": "2.11.4",
    "nuxt": "^3.16.2",
    "pinia": "^3.0.3",
    "radix-vue": "^1.9.17",
    "sass-embedded-darwin-arm64": "1.100.0",
    "three": "^0.175.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxtjs/tailwindcss": "^6.13.2",
    "@types/node": "^22.14.0",
    "@types/three": "^0.175.0",
    "autoprefixer": "^10.5.2",
    "dotenv": "^16.5.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "gulp": "^5.0.0",
    "postcss": "^8.5.19",
    "postcss-mobile-forever": "^5.0.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.101.0",
    "sass-embedded": "^1.100.0",
    "ssh2-sftp-client": "^12.0.1",
    "typescript": "~5.8.3",
    "vue-tsc": "^2.2.8"
  },
  "browserslist": [
    "Android >= 5",
    "iOS >= 11",
    "Chrome >= 64",
    "Safari >= 11",
    "Firefox >= 67",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
