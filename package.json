{
  "name": "three-city",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-cad-workers.mjs && vite",
    "draw-sync": "node server/draw-sync.cjs",
    "cad-convert": "node server/cad-convert.cjs",
    "dev:all": "run-p draw-sync cad-convert dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "deploy": "gulp deploy",
    "build-only": "node scripts/copy-cad-workers.mjs && vite build",
    "copy-cad-workers": "node scripts/copy-cad-workers.mjs",
    "postinstall": "node scripts/copy-cad-workers.mjs",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@mlightcad/cad-html-exporter": "1.5.1",
    "@mlightcad/cad-simple-viewer": "1.5.1",
    "@mlightcad/data-model": "^1.8.1",
    "@mlightcad/mtext-renderer": "^0.10.15",
    "@mlightcad/three-renderer": "1.5.1",
    "@velipso/polybool": "^1.1.1",
    "jszip": "^3.10.1",
    "lodash-es": "4.17.21",
    "three": "^0.184.0",
    "vue": "^3.5.29",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "dotenv": "^17.2.3",
    "gulp": "^5.0.1",
    "npm-run-all2": "^8.0.4",
    "ssh2-sftp-client": "^12.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
